# Leave these blank to run PulsePlan with built-in demo data.
NOTION_API_KEY=
NOTION_ASSIGNMENTS_DATA_SOURCE_ID=
NOTION_SESSIONS_DATA_SOURCE_ID=

# Optional assignment property overrides. PulsePlan auto-detects common names.
NOTION_PROP_TITLE=Name
NOTION_PROP_DUE=Due
NOTION_PROP_STATUS=Status
NOTION_PROP_COURSE=Course
NOTION_PROP_EFFORT=Estimated hours
NOTION_PROP_PRIORITY=Priority
NOTION_PROP_PROGRESS=Progress

# Optional Study Sessions property overrides.
NOTION_SESSION_TITLE=Name
NOTION_SESSION_DATE=Date
NOTION_SESSION_COURSE=Course
NOTION_SESSION_DURATION=Duration
NOTION_SESSION_STATUS=Status
NOTION_SESSION_SOURCE_URL=Source

# Optional Study Bot. Keep this server-side and use a dedicated OpenAI key.
# Without a key, the bot uses PulsePlan's deterministic local risk engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override only for a trusted OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1
